<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.parkflow</groupId>
    <artifactId>parkflow-database-migrations</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>ParkFlow - Liquibase Database Migrations</name>
    <description>Módulo de Control de Versiones y Migraciones de Base de Datos para ParkFlow con Liquibase</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <liquibase.version>4.27.0</liquibase.version>
        <mysql.connector.version>8.3.0</mysql.connector.version>
        
        <!-- Propiedades de Conexión a Base de Datos (Configuración por defecto XAMPP) -->
        <db.url>jdbc:mysql://localhost:3306/parkflow_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC&amp;characterEncoding=UTF-8</db.url>
        <db.username>root</db.username>
        <db.password></db.password>
        <db.driver>com.mysql.cj.jdbc.Driver</db.driver>
        <db.changelog>changelog/changelog-master.xml</db.changelog>
    </properties>

    <dependencies>
        <!-- MySQL Connector / J -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>${liquibase.version}</version>
                <configuration>
                    <propertyFileWillOverride>true</propertyFileWillOverride>
                    <propertyFile>liquibase.properties</propertyFile>
                    <changeLogFile>${db.changelog}</changeLogFile>
                    <driver>${db.driver}</driver>
                    <url>${db.url}</url>
                    <username>${db.username}</username>
                    <password>${db.password}</password>
                    <defaultSchemaName>parkflow_db</defaultSchemaName>
                    <verbose>true</verbose>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.mysql</groupId>
                        <artifactId>mysql-connector-j</artifactId>
                        <version>${mysql.connector.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
