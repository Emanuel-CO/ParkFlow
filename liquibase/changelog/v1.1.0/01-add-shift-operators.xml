<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.1.0-01-operator-shifts-support" author="parkflow-dev">
        <comment>Optimización e índices para la consulta y autenticación de Operadores de Turno</comment>
        
        <createIndex tableName="users" indexName="idx_users_role_shift">
            <column name="role"/>
            <column name="shift"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="users" indexName="idx_users_role_shift"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
